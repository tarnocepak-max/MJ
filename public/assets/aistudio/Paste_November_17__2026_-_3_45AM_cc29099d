<script>
  function switchSection(sectionId) {
    // Hide all panes
    const panes = document.querySelectorAll('.section-pane');
    panes.forEach(pane => pane.classList.add('hidden'));

    // Reset tab button styles
    const tabButtons = document.querySelectorAll('.tab-button');
    tabButtons.forEach(btn => {
      btn.className = 'tab-button flex items-center gap-space-xs px-space-md py-space-sm rounded-lg text-on-surface-variant hover:text-on-surface font-label-lg text-label-lg transition-all';
    });

    // Reveal target pane
    const target = document.getElementById('section-' + sectionId);
    if (target) {
      target.classList.remove('hidden');
    }

    // Set active button style
    const activeBtnMap = {
      'spec-buttons': 'tabBtn1',
      'spec-desktop': 'tabBtn2',
      'spec-mobile': 'tabBtn3',
      'spec-matrix': 'tabBtn4'
    };
    const activeBtn = document.getElementById(activeBtnMap[sectionId]);
    if (activeBtn) {
      activeBtn.className = 'tab-button flex items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-surface-container-lowest text-on-surface font-label-lg text-label-lg shadow-[0_3px_0_#cec3d4,0_6px_12px_rgba(31,22,56,0.06)] transition-all';
    }
  }

  function setSidebarDemo(mode) {
    const sidebar = document.getElementById('mockSidebar');
    const texts = document.querySelectorAll('.sidebar-text');
    const heading = document.getElementById('navHeading');
    const btnExp = document.getElementById('btnNavExpanded');
    const btnCol = document.getElementById('btnNavCollapsed');

    if (mode === 'collapsed') {
      sidebar.classList.remove('w-64');
      sidebar.classList.add('w-20');
      texts.forEach(t => t.classList.add('hidden'));
      if (heading) heading.classList.add('hidden');

      btnCol.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md shadow-[0_2px_0_#d0bcff] transition-all';
      btnExp.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-lg text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-lowest hover:text-on-surface transition-all';
    } else {
      sidebar.classList.remove('w-20');
      sidebar.classList.add('w-64');
      texts.forEach(t => t.classList.remove('hidden'));
      if (heading) heading.classList.remove('hidden');

      btnExp.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md shadow-[0_2px_0_#d0bcff] transition-all';
      btnCol.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-lg text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-lowest hover:text-on-surface transition-all';
    }
  }

  function triggerHaptic(element, actionName) {
    const logBox = document.getElementById('hapticLog');
    if (!logBox) return;

    const now = new Date();
    const timeStr = now.toTimeString().split(' ')[0] + '.' + String(now.getMilliseconds()).padStart(3, '0');

    const logEntry = document.createElement('div');
    logEntry.className = 'text-inverse-on-surface flex items-center justify-between text-xs animate-pulse';
    logEntry.innerHTML = `<span class="text-secondary-fixed-dim">[TACTILE_PRESS] &bull; <strong>${actionName}</strong></span><span class="text-on-surface-variant text-[10px]">${timeStr}</span>`;

    logBox.prepend(logEntry);

    // Keep log max 12 items
    while (logBox.children.length > 12) {
      logBox.removeChild(logBox.lastChild);
    }
  }

  function clearHapticLog() {
    const logBox = document.getElementById('hapticLog');
    if (logBox) {
      logBox.innerHTML = '<div class="text-secondary-fixed-dim">[STREAM_RESET] Log buffer cleared. Ready for input.</div>';
    }
  }
