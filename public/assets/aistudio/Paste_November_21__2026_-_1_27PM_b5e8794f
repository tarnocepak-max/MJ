        // Visually flag the active row as resolved
        if (currentActiveWo === 'WO-20261120-0048') {
          const row = document.getElementById('row-wo-1');
          if (row) {
            row.classList.remove('border-error', 'bg-error-container/10');
            row.classList.add('border-secondary', 'bg-surface-container-low/40', 'opacity-70');
          }
        }
      }, 700);
    }

    function resetDrawerForm() {
      const noteInput = document.getElementById('leaderNoteInput');
      const successAlert = document.getElementById('reassignSuccessAlert');
      if (noteInput) noteInput.value = '';
      if (successAlert) successAlert.classList.add('hidden');
    }

    function triggerRefreshAnimation() {
      const btn = document.getElementById('refreshBtn');
      if (btn) {
        const icon = btn.querySelector('.material-symbols-outlined');
        if (icon) icon.classList.add('animate-spin');
        setTimeout(() => {
          if (icon) icon.classList.remove('animate-spin');
        }, 800);
      }
    }
  </script>
