<!-- Vanilla JavaScript Logic for Interactive 3D Tactile Toasts -->
<script>
    let toastIndex = 0;
    const toastViewport = document.getElementById('morajaws-toast-viewport');
    const toastCounterEl = document.getElementById('toast-counter');
    let soundEnabled = true;

    function updateCount() {
      if (toastCounterEl && toastViewport) {
        toastCounterEl.innerText = toastViewport.children.length;
      }
    }

    function toggleTactileAudio() {
      soundEnabled = !soundEnabled;
      window.MoraAudio.toggle(soundEnabled);
      const icon = document.getElementById('audio-icon');
      const text = document.getElementById('audio-status-text');
      if (soundEnabled) {
        icon.innerText = 'volume_up';
        icon.className = 'material-symbols-outlined text-primary text-[20px]';
        text.innerText = 'Operational Chirps: ON';
        window.MoraAudio.play('click');
      } else {
        icon.innerText = 'volume_off';
        icon.className = 'material-symbols-outlined text-outline text-[20px]';
        text.innerText = 'Operational Chirps: MUTED';
      }
    }

    function create3DToast(config) {
      toastIndex++;
      const id = 'toast-' + toastIndex;
      window.MoraAudio.play(config.type);

      // Card wrapper with Spring Slide-in and 3D Extrusion
      const toastEl = document.createElement('div');
      toastEl.id = id;
      toastEl.className = 'pointer-events-auto relative w-full rounded-2xl bg-surface-container-lowest p-4 transition-all duration-300 transform translate-x-32 opacity-0 ' + config.shadowClass;
      toastEl.style.boxShadow = config.customShadow || '0 10px 25px -5px rgba(22, 13, 41, 0.15), 0 4px 6px -2px rgba(53, 16, 94, 0.08)';
      
      let actionBtnHtml = '';
      if (config.actionText) {
        actionBtnHtml = `
          <button onclick="${config.actionFunc}" class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider ${config.actionBtnClass} active:scale-95 transition-all">
            <span>${config.actionText}</span>
            <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
          </button>
        `;
      }

      toastEl.innerHTML = `
        <div class="absolute left-0 top-0 bottom-0 w-2 rounded-l-2xl ${config.spineBg}"></div>
        <div class="flex items-start gap-3 pl-1.5">
          <div class="w-9 h-9 rounded-xl ${config.iconBg} flex items-center justify-center flex-shrink-0 ${config.iconColor} shadow-[inset_0_1px_0_0_rgba(255,255,255,0.8)]">
            <span class="material-symbols-outlined text-[20px]">${config.icon}</span>
          </div>
          <div class="flex flex-col flex-1 min-w-0 pr-1">
            <div class="flex items-center justify-between">
              <span class="font-label-sm text-label-sm ${config.badgeColor} font-bold uppercase tracking-wider">${config.badge}</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant font-mono">Just now</span>
            </div>
            <div class="font-title-md text-body-md font-bold text-on-surface mt-0.5 truncate">${config.title}</div>
            <div class="font-body-sm text-body-sm text-on-surface-variant mt-0.5 leading-snug">${config.message}</div>
            ${actionBtnHtml}
          </div>
          <button onclick="dismissToast('${id}')" class="p-1 rounded-lg text-on-surface-variant hover:bg-surface-container active:scale-90 transition-all flex-shrink-0">
            <span class="material-symbols-outlined text-[18px]">close</span>
          </button>
        </div>
        <!-- Draining Progress Bar -->
        <div class="mt-3 w-full bg-surface-container rounded-full h-1 overflow-hidden">
          <div id="${id}-progress" class="h-full rounded-full ${config.progressBg} transition-all duration-[4800ms] ease-linear w-full"></div>
        </div>
      `;

      toastViewport.appendChild(toastEl);
      updateCount();

      // Trigger Spring Animation entry
      requestAnimationFrame(() => {
        toastEl.classList.remove('translate-x-32', 'opacity-0');
        toastEl.classList.add('translate-x-0', 'opacity-100');
        toastEl.style.transition = 'transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease';

        // Trigger progress drain
        const prog = document.getElementById(`${id}-progress`);
        if (prog) {
          setTimeout(() => {
            prog.style.width = '0%';
          }, 30);
        }
      });

      // Hover latch (Pause timer on mouseover)
      let timer = setTimeout(() => {
        dismissToast(id);
      }, 4830);

      toastEl.addEventListener('mouseenter', () => {
        clearTimeout(timer);
        const prog = document.getElementById(`${id}-progress`);
        if (prog) {
          const comp = window.getComputedStyle(prog);
          prog.style.transition = 'none';
          prog.style.width = comp.width;
        }
      });

      toastEl.addEventListener('mouseleave', () => {
        const prog = document.getElementById(`${id}-progress`);
        if (prog) {
          prog.style.transition = 'width 2400ms linear';
          prog.style.width = '0%';
        }
        timer = setTimeout(() => {
          dismissToast(id);
        }, 2400);
      });
    }

    function dismissToast(id) {
      const toastEl = document.getElementById(id);
      if (!toastEl) return;
      toastEl.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 1, 1), opacity 0.25s ease';
      toastEl.classList.remove('translate-x-0');
      toastEl.classList.add('translate-x-48', 'opacity-0');
      setTimeout(() => {
        if (toastEl && toastEl.parentNode) {
          toastEl.parentNode.removeChild(toastEl);
          updateCount();
        }
      }, 300);
    }

    function clearAllToasts() {
      window.MoraAudio.play('click');
      if (toastViewport) {
        toastViewport.innerHTML = '';
        updateCount();
      }
    }

    // Trigger Helpers
    function triggerSuccessToast() {
      create3DToast({
        type: 'success',
        icon: 'check_circle',
        badge: 'Dispatch Success',
        badgeColor: 'text-emerald-700',
        title: 'WO Approved & Dispatched',
        message: 'Order #WO-9941 terkirim ke Regu Alpha (Dago Sector). ETA Teknisi 18 min.',
        spineBg: 'bg-emerald-500 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.7)]',
        iconBg: 'bg-emerald-100',
        iconColor: 'text-emerald-700',
        progressBg: 'bg-emerald-500',
        shadowClass: 'shadow-[0_12px_28px_rgba(16,185,129,0.18),0_2px_4px_rgba(33,24,58,0.06)]'
      });
    }

    function triggerWarningToast() {
      create3DToast({
        type: 'warning',
        icon: 'warning',
        badge: 'Attenuation Warning',
        badgeColor: 'text-amber-700',
        title: 'Redaman Melebihi Ambang',
        message: '-24.8 dBm terdeteksi di ODP-PSD-04. Nilai toleransi standar -22.0 dBm.',
        spineBg: 'bg-amber-500 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.7)]',
        iconBg: 'bg-amber-100',
        iconColor: 'text-amber-700',
        progressBg: 'bg-amber-500',
        shadowClass: 'shadow-[0_12px_28px_rgba(245,158,11,0.18),0_2px_4px_rgba(33,24,58,0.06)]'
      });
    }

    function triggerDangerToast() {
      create3DToast({
        type: 'danger',
        icon: 'e911_emergency',
        badge: 'Red Alert P1',
        badgeColor: 'text-rose-700',
        title: 'Drop Cable Cut Incident!',
        message: 'Pemutusan fisik FO terkonfirmasi di Jl. Dago Atas No. 41. 14 port terputus.',
        spineBg: 'bg-rose-600 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.7)]',
        iconBg: 'bg-rose-100',
        iconColor: 'text-rose-700',
        progressBg: 'bg-rose-600',
        actionText: 'Lihat Insiden Room',
        actionFunc: 'spawnModalAlert("Insiden FO Terputus Dago", "Insiden #INC-4402 dalam penanganan. 2 armada standby telah dikirim ke lokasi.", "danger")',
        actionBtnClass: 'bg-rose-600 text-white hover:bg-rose-700 shadow-sm',
        shadowClass: 'shadow-[0_14px_32px_rgba(239,68,68,0.22),0_2px_4px_rgba(33,24,58,0.06)]'
      });
    }

    function triggerInfoToast() {
      create3DToast({
        type: 'info',
        icon: 'cloud_sync',
        badge: 'Relay Synchronization',
        badgeColor: 'text-primary',
        title: 'Auto-Sync Telemetry Selesai',
        message: '42 Work Orders dan status node FTTH berhasil disinkronkan ke pusat kendali.',
        spineBg: 'bg-primary shadow-[inset_0_1px_0_0_rgba(255,255,255,0.7)]',
        iconBg: 'bg-surface-container',
        iconColor: 'text-primary',
        progressBg: 'bg-primary',
        shadowClass: 'shadow-[0_12px_28px_rgba(113,53,181,0.18),0_2px_4px_rgba(33,24,58,0.06)]'
      });
    }

    function triggerQuickDispatch(area) {
      window.MoraAudio.play('success');
      create3DToast({
        type: 'success',
        icon: 'send_time_extension',
        badge: 'Unit Dispatched',
        badgeColor: 'text-emerald-700',
        title: 'Armada Cepat Bergerak',
        message: 'Regu Charlie terdekat ditugaskan ke ' + area + '. Sirene patroli diaktifkan.',
        spineBg: 'bg-emerald-500',
        iconBg: 'bg-emerald-100',
        iconColor: 'text-emerald-700',
        progressBg: 'bg-emerald-500',
        shadowClass: 'shadow-[0_12px_28px_rgba(16,185,129,0.18)]'
      });
    }

    function downloadReport() {
      window.MoraAudio.play('info');
      create3DToast({
        type: 'info',
        icon: 'file_download_done',
        badge: 'Export Complete',
        badgeColor: 'text-primary',
        title: 'Laporan Siap Diunduh',
        message: 'PDF Sertifikasi Redaman ONT-36/36 telah digenerate (2.4 MB).',
        spineBg: 'bg-primary',
        iconBg: 'bg-surface-container',
        iconColor: 'text-primary',
        progressBg: 'bg-primary',
        shadowClass: 'shadow-[0_12px_28px_rgba(113,53,181,0.18)]'
      });
    }

    // Modal Alert logic
    function spawnModalAlert(title, message, type) {
      window.MoraAudio.play('warning');
      const modal = document.getElementById('action-modal');
      const box = document.getElementById('action-modal-box');
      const titleEl = document.getElementById('modal-title');
      const bodyEl = document.getElementById('modal-body');
      const badge = document.getElementById('modal-icon-badge');
      const icon = document.getElementById('modal-icon');

      titleEl.innerText = title;
      bodyEl.innerText = message;

      if (type === 'danger') {
        badge.className = 'w-9 h-9 rounded-lg flex items-center justify-center bg-rose-100 text-rose-700';
        icon.innerText = 'warning';
      } else if (type === 'warning') {
        badge.className = 'w-9 h-9 rounded-lg flex items-center justify-center bg-amber-100 text-amber-700';
        icon.innerText = 'crisis_alert';
      } else {
        badge.className = 'w-9 h-9 rounded-lg flex items-center justify-center bg-primary-fixed text-primary';
        icon.innerText = 'info';
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      requestAnimationFrame(() => {
        box.classList.remove('scale-95', 'opacity-0');
        box.classList.add('scale-100', 'opacity-100');
      });
    }

    function closeModalAlert() {
      const modal = document.getElementById('action-modal');
      const box = document.getElementById('action-modal-box');
      box.classList.remove('scale-100', 'opacity-100');
      box.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }, 150);
    }

    function confirmModalAction() {
      closeModalAlert();
      triggerSuccessToast();
    }

    // Initialize with a welcome demonstration toast
    window.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        triggerInfoToast();
      }, 700);
    });
  </script>
