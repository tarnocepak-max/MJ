<script>
  function switchRoleView(role) {
    const btnSuper = document.getElementById('roleBtnSuperadmin');
    const btnMgt = document.getElementById('roleBtnManagement');
    const btnDisp = document.getElementById('roleBtnDispatch');

    // Reset all buttons to default inactive state
    [btnSuper, btnMgt, btnDisp].forEach(btn => {
      btn.className = "flex items-center gap-2 px-3.5 py-2 rounded-lg font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all";
    });

    if (role === 'superadmin') {
      btnSuper.className = "flex items-center gap-2 px-4 py-2 rounded-lg font-label-md text-label-md bg-primary text-on-primary font-semibold shadow-[0_4px_12px_rgba(88,20,156,0.25)] transition-all";
    } else if (role === 'management') {
      btnMgt.className = "flex items-center gap-2 px-4 py-2 rounded-lg font-label-md text-label-md bg-primary text-on-primary font-semibold shadow-[0_4px_12px_rgba(88,20,156,0.25)] transition-all";
    } else if (role === 'dispatch') {
      btnDisp.className = "flex items-center gap-2 px-4 py-2 rounded-lg font-label-md text-label-md bg-secondary text-on-secondary font-semibold shadow-[0_4px_12px_rgba(106,70,193,0.25)] transition-all";
    }
  }

  // Quick feedback for tactile buttons
  document.getElementById('btnExportMatrix')?.addEventListener('click', () => {
    alert("Mengunduh Security Access Matrix JSON/CSV untuk audit kluster JKT-01...");
  });

  document.getElementById('btnAuditLog')?.addEventListener('click', () => {
    alert("Token Keamanan Aktif: JWT valid hingga 8 jam kedepan. HMAC signature terverifikasi.");
  });
</script></main></div></body></html>