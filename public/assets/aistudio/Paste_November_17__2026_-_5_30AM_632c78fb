<script>
  function handleKeyDown(event) {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      handleSendMessage(event);
    }
  }

  function handleSendMessage(event) {
    if (event) event.preventDefault();
    const input = document.getElementById('messageInput');
    const text = input.value.trim();
    if (!text) return;

    const stream = document.getElementById('chatStream');
    const timeStr = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';

    const newMsg = document.createElement('div');
    newMsg.className = 'flex items-start gap-space-sm max-w-2xl';
    newMsg.innerHTML = `
      <div class="relative flex-shrink-0">
        <div class="w-9 h-9 rounded-xl bg-primary-container text-on-primary font-headline-sm text-label-lg font-bold flex items-center justify-center shadow-sm"
             style="box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 2px 0 #35105e;">
          SW
        </div>
        <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-surface-container-lowest rounded-full flex items-center justify-center shadow-xs">
          <span class="w-2 h-2 rounded-full bg-primary-container"></span>
        </span>
      </div>
      <div class="flex flex-col gap-1 min-w-0">
        <div class="flex items-center gap-2">
          <span class="font-label-md text-label-md font-bold text-on-surface">Sari Wulandari</span>
          <span class="px-1.5 py-0.2 rounded bg-surface-container-high text-primary font-label-sm text-[10px] font-bold">DISPATCH</span>
          <span class="font-label-sm text-label-sm text-outline">${timeStr}</span>
        </div>
        <div class="p-space-md rounded-2xl rounded-tl-sm bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-md"
             style="box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 3px 0 #e8ddff, 0 6px 14px -2px rgba(31, 22, 56, 0.06);">
          <p>${escapeHtml(text)}</p>
        </div>
      </div>
    `;

    stream.appendChild(newMsg);
    input.value = '';
    stream.scrollTop = stream.scrollHeight;
  }

  function insertQuickReply(text) {
    const input = document.getElementById('messageInput');
    input.value = text;
    input.focus();
  }

  function escapeHtml(string) {
    const pre = document.createElement('pre');
    const textNode = document.createTextNode(string);
    pre.appendChild(textNode);
    return pre.innerHTML;
  }

  function toggleDetailDrawer() {
    const drawer = document.getElementById('ticketDrawer');
    if (drawer.classList.contains('hidden')) {
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
    } else {
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
    }
  }

  document.getElementById('btnToggleDetail')?.addEventListener('click', toggleDetailDrawer);
</script></main></div></body></html>