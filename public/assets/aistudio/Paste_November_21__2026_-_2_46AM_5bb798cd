        this.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-error"></span><span>PAUSED</span>';
        this.classList.remove('bg-secondary', 'text-on-secondary');
        this.classList.add('bg-error-container', 'text-on-error-container');
      } else {
        this.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-surface-bright animate-ping"></span><span>ONLINE</span>';
        this.classList.remove('bg-error-container', 'text-on-error-container');
        this.classList.add('bg-secondary', 'text-on-secondary');
      }
    });
  }
</script></main></div></body></html>