<script>
  function updateSimulatorCode(title, className, label) {
    const titleEl = document.getElementById('snippet-title');
    const outputEl = document.getElementById('code-output');
    
    if (titleEl) titleEl.innerText = 'Token Inspector: ' + title;

    let snippet = '';
    if (className.includes('leader-primary')) {
      snippet = `/* MoraJaws 3D Leader Primary */\n.mj-btn-leader-primary {\n  background: linear-gradient(180deg, #123C45 0%, #0c282e 100%);\n  box-shadow: inset 0 1px 0 0 #42C6B5, 0 4px 0 0 #07171b, 0 8px 16px rgba(18,60,69,0.3);\n  color: #ffffff;\n  border-radius: 0.5rem;\n  transition: transform 75ms ease, box-shadow 75ms ease;\n}\n.mj-btn-leader-primary:active {\n  transform: translateY(2px);\n  box-shadow: inset 0 2px 4px rgba(0,0,0,0.5), 0 2px 0 0 #07171b;\n}`;
    } else if (className.includes('leader-secondary')) {
      snippet = `/* MoraJaws 3D Leader Secondary */\n.mj-btn-leader-secondary {\n  background: linear-gradient(180deg, #167C80 0%, #116265 100%);\n  box-shadow: inset 0 1px 0 0 #D9F2ED, 0 4px 0 0 #0d4648, 0 6px 14px rgba(22,124,128,0.25);\n  color: #ffffff;\n  border-radius: 0.5rem;\n}\n.mj-btn-leader-secondary:active {\n  transform: translateY(2px);\n  box-shadow: inset 0 2px 4px rgba(0,0,0,0.4), 0 2px 0 0 #0d4648;\n}`;
    } else if (className.includes('leader-warning')) {
      snippet = `/* MoraJaws 3D Leader Warning */\n.mj-btn-leader-warning {\n  background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);\n  box-shadow: inset 0 1px 0 0 rgba(255,255,255,0.7), 0 4px 0 0 #b45309, 0 6px 14px rgba(245,158,11,0.3);\n  color: #ffffff;\n  border-radius: 0.5rem;\n}\n.mj-btn-leader-warning:active {\n  transform: translateY(2px);\n  box-shadow: inset 0 2px 4px rgba(0,0,0,0.35), 0 2px 0 0 #b45309;\n}`;
    } else if (className.includes('installer-primary')) {
      snippet = `/* MoraJaws 3D Installer Primary (Field Spec) */\n.mj-btn-installer-primary {\n  min-height: 48px;\n  background: linear-gradient(180deg, #263B2D 0%, #1a2a20 100%);\n  box-shadow: inset 0 1px 0 0 #76B985, 0 5px 0 0 #121c16, 0 10px 20px rgba(38,59,45,0.35);\n  color: #ffffff;\n  border-radius: 0.5rem;\n  transition: transform 75ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n.mj-btn-installer-primary:active {\n  transform: translateY(3px);\n  box-shadow: inset 0 3px 5px rgba(0,0,0,0.6), 0 2px 0 0 #121c16;\n}`;
    } else if (className.includes('installer-secondary')) {
      snippet = `/* MoraJaws 3D Installer Secondary */\n.mj-btn-installer-secondary {\n  min-height: 48px;\n  background: linear-gradient(180deg, #3D8655 0%, #2e6640 100%);\n  box-shadow: inset 0 1px 0 0 #EAF3E9, 0 5px 0 0 #1f472c;\n  color: #ffffff;\n  border-radius: 0.5rem;\n}\n.mj-btn-installer-secondary:active {\n  transform: translateY(3px);\n  box-shadow: inset 0 3px 5px rgba(0,0,0,0.4), 0 2px 0 0 #1f472c;\n}`;
    } else if (className.includes('installer-warning')) {
      snippet = `/* MoraJaws 3D Installer Warning (Sunlight High Contrast) */\n.mj-btn-installer-warning {\n  min-height: 48px;\n  background: linear-gradient(180deg, #E6A23C 0%, #ca8a04 100%);\n  box-shadow: inset 0 1px 0 0 rgba(255,255,255,0.7), 0 5px 0 0 #936004, 0 8px 16px rgba(230,162,60,0.35);\n  color: #ffffff;\n  border-radius: 0.5rem;\n}\n.mj-btn-installer-warning:active {\n  transform: translateY(3px);\n  box-shadow: inset 0 3px 5px rgba(0,0,0,0.4), 0 2px 0 0 #936004;\n}`;
    } else {
      snippet = `/* MoraJaws 3D Generic Token (${title}) */\n<button class="font-label-md text-label-md px-5 py-2.5 rounded-lg font-semibold transition-all select-none">\n  ${label}\n</button>`;
    }

    if (outputEl) outputEl.innerText = snippet;
  }

  function copySnippetCode() {
    const outputEl = document.getElementById('code-output');
    const copyTextEl = document.getElementById('copy-text');
    const copyIconEl = document.getElementById('copy-icon');
    
    if (outputEl && navigator.clipboard) {
      navigator.clipboard.writeText(outputEl.innerText).then(() => {
        if (copyTextEl) copyTextEl.innerText = 'Tersalin!';
        if (copyIconEl) copyIconEl.innerText = 'done';
        setTimeout(() => {
          if (copyTextEl) copyTextEl.innerText = 'Salin Snippet';
          if (copyIconEl) copyIconEl.innerText = 'content_copy';
        }, 2000);
      });
    }
  }
