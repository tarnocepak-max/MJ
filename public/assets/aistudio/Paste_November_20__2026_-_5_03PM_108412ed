  (function () {
    // 1. Grid Composition Toggle
    const gridToggleBtn = document.getElementById('toggle-grid-btn');
    const ruleGrid = document.getElementById('rule-grid');
    let gridVisible = true;

    if (gridToggleBtn && ruleGrid) {
      gridToggleBtn.addEventListener('click', () => {
        gridVisible = !gridVisible;
        ruleGrid.classList.toggle('opacity-0', !gridVisible);
        ruleGrid.classList.toggle('opacity-60', gridVisible);
        gridToggleBtn.classList.toggle('bg-primary/20', gridVisible);
        gridToggleBtn.classList.toggle('text-primary', gridVisible);
        gridToggleBtn.classList.toggle('text-on-surface-variant', !gridVisible);
      });
    }

    // 2. Flash Modes Toggle
    const flashBtn = document.getElementById('toggle-flash-btn');
    const flashIcon = document.getElementById('flash-icon');
    const flashStates = ['flash_auto', 'flash_on', 'flash_off'];
    let flashIdx = 0;

    if (flashBtn && flashIcon) {
      flashBtn.addEventListener('click', () => {
        flashIdx = (flashIdx + 1) % flashStates.length;
        flashIcon.textContent = flashStates[flashIdx];
        if (flashIdx === 1) {
          flashBtn.classList.add('text-secondary');
        } else {
          flashBtn.classList.remove('text-secondary');
        }
      });
    }

    // 3. Zoom Factor Switcher
    const zoomButtons = document.querySelectorAll('.zoom-btn');
    const cameraViewport = document.getElementById('camera-viewport');

    zoomButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        zoomButtons.forEach((b) => {
          b.className = 'zoom-btn px-3 py-1 rounded-full font-label-sm text-label-sm text-on-surface-variant transition-all hover:text-on-surface';
        });
        btn.className = 'zoom-btn px-3 py-1 rounded-full font-label-sm text-label-sm bg-primary text-on-primary font-bold shadow-md transition-all';
        
        const zoom = parseFloat(btn.getAttribute('data-zoom') || '1.0');
        if (cameraViewport) {
          cameraViewport.style.transform = `scale(${zoom})`;
        }
      });
    });

    // 4. Notes & Telemetry Drawer Bottom Sheet Management
    const notesSheet = document.getElementById('notes-sheet');
    const openNotesBtn = document.getElementById('open-notes-btn');
    const telemetryTrigger = document.getElementById('telemetry-trigger');
    const closeNotesBtn = document.getElementById('close-notes-btn');
    const sheetHandle = document.getElementById('sheet-handle');
    const saveNotesBtn = document.getElementById('save-notes-btn');

    function openSheet() {
      if (notesSheet) {
        notesSheet.classList.remove('translate-y-full');
        notesSheet.classList.add('translate-y-0');
      }
    }

    function closeSheet() {
      if (notesSheet) {
        notesSheet.classList.add('translate-y-full');
        notesSheet.classList.remove('translate-y-0');
      }
    }

    if (openNotesBtn) openNotesBtn.addEventListener('click', openSheet);
    if (telemetryTrigger) telemetryTrigger.addEventListener('click', openSheet);
    if (closeNotesBtn) closeNotesBtn.addEventListener('click', closeSheet);
    if (sheetHandle) sheetHandle.addEventListener('click', closeSheet);
    if (saveNotesBtn) saveNotesBtn.addEventListener('click', closeSheet);

    // 5. Notes Character Count & Quick Chips
    const notesInput = document.getElementById('odp-notes-input');
    const charCounter = document.getElementById('char-counter');
    const tagChips = document.querySelectorAll('.tag-chip');

    if (notesInput && charCounter) {
      notesInput.addEventListener('input', () => {
        const len = notesInput.value.length;
        charCounter.textContent = `${len} / 120`;
      });
    }

    tagChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (!notesInput) return;
        const textToAdd = chip.textContent ? chip.textContent.replace('+ ', '').trim() : '';
        if (notesInput.value.length + textToAdd.length + 2 <= 120) {
          notesInput.value += (notesInput.value ? ', ' : '') + textToAdd;
          if (charCounter) {
            charCounter.textContent = `${notesInput.value.length} / 120`;
          }
        }
      });
    });

    // 6. Realistic Shutter Capture Actuation
    const shutterBtn = document.getElementById('shutter-btn');
    const flashOverlay = document.getElementById('capture-flash');
    const captureToast = document.getElementById('capture-toast');

    if (shutterBtn && flashOverlay && captureToast) {
      shutterBtn.addEventListener('click', () => {
        // Visual Shutter Flash
        flashOverlay.style.opacity = '0.85';
        setTimeout(() => {
          flashOverlay.style.opacity = '0';
        }, 120);

        // Toast feedback
        captureToast.classList.remove('-translate-y-20', 'opacity-0');
        captureToast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          captureToast.classList.add('-translate-y-20', 'opacity-0');
          captureToast.classList.remove('translate-y-0', 'opacity-100');
        }, 2200);
      });
    }

    // 7. Lens Flip Switch Micro-Interaction
    const flipBtn = document.getElementById('flip-camera-btn');
    if (flipBtn && cameraViewport) {
      let isMirrored = false;
      flipBtn.addEventListener('click', () => {
        isMirrored = !isMirrored;
        cameraViewport.style.filter = 'blur(4px)';
        setTimeout(() => {
          cameraViewport.style.transform = isMirrored ? 'scaleX(-1)' : 'scaleX(1)';
          cameraViewport.style.filter = 'none';
        }, 150);
      });
    }
  })();
</script></main></body></html>