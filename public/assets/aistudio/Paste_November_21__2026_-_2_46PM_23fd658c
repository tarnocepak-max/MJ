  (function () {
    // 1. Highlight active sidebar menu "Dashboard Progress"
    const nav = document.querySelector('nav[data-active-classes]');
    if (nav) {
      const activeClasses = nav.getAttribute('data-active-classes').split(' ');
      nav.querySelectorAll('a[data-path]').forEach((link) => {
        if (link.getAttribute('data-path') === 'dashboard-progress') {
          link.classList.add(...activeClasses);
          link.classList.remove('text-on-surface-variant');
        } else {
          link.classList.remove(...activeClasses);
        }
      });
    }

    // 2. Filter logic
    const searchInput = document.getElementById('search-input');
    const statusFilter = document.getElementById('status-filter');
    const teknisiFilter = document.getElementById('teknisi-filter');
    const resetBtn = document.getElementById('btn-reset-filter');
    const rows = document.querySelectorAll('.wo-row');
    const rowCountBadge = document.getElementById('row-count-badge');

    function applyFilters() {
      const q = (searchInput.value || '').toLowerCase().trim();
      const st = statusFilter.value;
      const tek = teknisiFilter.value;
      let visible = 0;

      rows.forEach((row) => {
        const matchSearch = !q || row.dataset.search.toLowerCase().includes(q);
        const matchStatus = st === 'ALL' || row.dataset.status === st;
        const matchTeknisi = tek === 'ALL' || row.dataset.teknisi === tek;

        if (matchSearch && matchStatus && matchTeknisi) {
          row.classList.remove('hidden');
          visible++;
        } else {
          row.classList.add('hidden');
        }
      });

      rowCountBadge.textContent = visible + ' Ditampilkan';
    }

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    teknisiFilter.addEventListener('change', applyFilters);

    resetBtn.addEventListener('click', () => {
      searchInput.value = '';
      statusFilter.value = 'ALL';
      teknisiFilter.value = 'ALL';
      applyFilters();
    });

    // Click summary cards to filter by status
    document.querySelectorAll('.status-summary-card').forEach((card) => {
      card.addEventListener('click', () => {
        const targetStatus = card.getAttribute('data-filter-status');
        statusFilter.value = statusFilter.value === targetStatus ? 'ALL' : targetStatus;
        applyFilters();
      });
    });

    // Toggle filter bar visibility
    document.getElementById('btn-toggle-filter').addEventListener('click', () => {
      document.getElementById('filter-bar-section').classList.toggle('hidden');
    });

    // Refresh Live button
    document.getElementById('btn-refresh-live').addEventListener('click', () => {
      const icon = document.getElementById('refresh-icon');
      icon.classList.add('animate-spin');
      setTimeout(() => {
        icon.classList.remove('animate-spin');
        const now = new Date();
        const timeStr = now.toTimeString().split(' ')[0];
        document.getElementById('last-sync-text').textContent = 'Sync terakhir: ' + timeStr + ' WIB';
      }, 600);
    });

    // Modal for Detail Pekerjaan & Photo Zoom
    const modal = document.getElementById('detail-modal');
    const modalWoCode = document.getElementById('modal-wo-code');
    const modalTitle = document.getElementById('modal-title');
    const modalBody = document.getElementById('modal-body');

    function openModal(wo, title, bodyHtml) {
      modalWoCode.textContent = wo;
      modalTitle.textContent = title;
      modalBody.innerHTML = bodyHtml;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    document.getElementById('close-modal-btn').addEventListener('click', closeModal);
    document.getElementById('modal-ok-btn').addEventListener('click', closeModal);

    document.querySelectorAll('.btn-detail-wo').forEach((btn) => {
