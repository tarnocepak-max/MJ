<script>
  (function() {
    // Highlight active sidebar menu "Kuota & Kolom"
    const navLinks = document.querySelectorAll('aside nav a[data-path]');
    const navContainer = document.querySelector('aside nav');
    const activeClasses = navContainer ? (navContainer.getAttribute('data-active-classes') || '').split(' ').filter(Boolean) : [];
    navLinks.forEach(link => {
      if (link.getAttribute('data-path') === 'kuota-dan-kolom') {
        activeClasses.forEach(cls => link.classList.add(cls));
        link.classList.remove('text-on-surface-variant');
      } else {
        activeClasses.forEach(cls => link.classList.remove(cls));
      }
    });

    // Strict Limit Enforcement Toggle
    const toggleBtn = document.getElementById('toggle-strict-limit');
    const toggleKnob = document.getElementById('toggle-strict-knob');
    let isStrict = true;

    toggleBtn.addEventListener('click', () => {
      isStrict = !isStrict;
      toggleBtn.setAttribute('aria-checked', String(isStrict));
      if (isStrict) {
        toggleBtn.classList.remove('bg-outline');
        toggleBtn.classList.add('bg-secondary');
        toggleKnob.classList.add('translate-x-6');
        toggleKnob.classList.remove('translate-x-0');
      } else {
        toggleBtn.classList.remove('bg-secondary');
        toggleBtn.classList.add('bg-outline');
        toggleKnob.classList.remove('translate-x-6');
        toggleKnob.classList.add('translate-x-0');
      }
    });

    // Capacity Simulation Update
    const inputKuotaArea = document.getElementById('input-kuota-area');
    const inputLimitTeknisi = document.getElementById('input-limit-teknisi');
    const simText = document.getElementById('simulasi-kapasitas-text');
    const simBar = document.getElementById('simulasi-kapasitas-bar');

    function updateCapacitySim() {
      const areaQuota = parseInt(inputKuotaArea.value, 10) || 0;
      const techLimit = parseInt(inputLimitTeknisi.value, 10) || 1;
      const totalSlots = 14 * techLimit;
      const pct = Math.min(100, Math.round((areaQuota / totalSlots) * 100));
      simText.textContent = `${areaQuota} WO / ${totalSlots} Slot Tersedia (${pct}%)`;
      simBar.style.width = `${pct}%`;
      if (pct > 90) {
        simBar.className = 'h-full rounded-full bg-error transition-all duration-300';
      } else {
        simBar.className = 'h-full rounded-full bg-secondary transition-all duration-300';
      }
    }
    inputKuotaArea.addEventListener('input', updateCapacitySim);
    inputLimitTeknisi.addEventListener('input', updateCapacitySim);

    // Column Visibility & Preview
    const colToggles = document.querySelectorAll('.col-toggle');
    const previewContainer = document.getElementById('column-preview-pills');
    const countBadge = document.getElementById('active-columns-count');

    function updateColumnPreview() {
      previewContainer.innerHTML = '';
      let activeCount = 0;
      colToggles.forEach((cb, idx) => {
        if (cb.checked) {
          activeCount++;
          const pill = document.createElement('span');
          pill.className = 'px-space-sm py-1 rounded-lg bg-surface-container-lowest text-primary font-label-sm text-label-sm shadow-sm flex items-center gap-1';
          pill.innerHTML = `<span class="font-data-mono text-secondary">${activeCount}.</span> ${cb.getAttribute('data-col-name')}`;
          previewContainer.appendChild(pill);
        }
      });
      countBadge.textContent = `${activeCount}/${colToggles.length} AKTIF`;
    }

    colToggles.forEach(cb => cb.addEventListener('change', updateColumnPreview));
    updateColumnPreview();

    // Remove exception row
    document.querySelectorAll('.btn-remove-exception').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = e.target.closest('.grid');
        if (row) row.remove();
      });
    });

    // Toast helper
    const toast = document.getElementById('config-toast');
    const toastMsg = document.getElementById('config-toast-msg');
    function showToast(msg) {
      toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 3000);
    }

    document.getElementById('btn-save-config').addEventListener('click', () => {
      showToast('Konfigurasi Kuota & Kolom Bandung 02 berhasil disimpan!');
    });

    document.getElementById('btn-reset-default').addEventListener('click', () => {
      inputKuotaArea.value = 50;
      inputLimitTeknisi.value = 4;
      updateCapacitySim();
      if (!isStrict) toggleBtn.click();
      colToggles.forEach((cb, i) => {
        cb.checked = ![5, 8].includes(i);
      });
      updateColumnPreview();
      showToast('Pengaturan dikembalikan ke konfigurasi default.');
    });
  })();
</script></main></div></body></html>