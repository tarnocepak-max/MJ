</section>
</div>
<script>
  (function () {
    const btnSubmit = document.getElementById('btn-submit-wo');
    const btnReset = document.getElementById('btn-reset-signature');
    const picInput = document.getElementById('pic_name');

    if (btnReset && picInput) {
      btnReset.addEventListener('click', function () {
        picInput.value = '';
        picInput.focus();
      });
    }

    if (btnSubmit) {
      btnSubmit.addEventListener('click', function () {
        const originalContent = btnSubmit.innerHTML;
        btnSubmit.innerHTML = `
          <span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span>
          <span>Memperbarui Status...</span>
        `;
        btnSubmit.classList.add('opacity-90', 'pointer-events-none');

        setTimeout(() => {
          btnSubmit.innerHTML = `
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>Status Berhasil Diperbarui!</span>
          `;
          setTimeout(() => {
            btnSubmit.innerHTML = originalContent;
            btnSubmit.classList.remove('opacity-90', 'pointer-events-none');
          }, 1800);
        }, 1000);
      });
    }
  })();
</script></main></body></html>