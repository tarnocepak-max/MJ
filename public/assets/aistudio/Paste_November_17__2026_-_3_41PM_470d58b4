  // Close escalation dropdown when clicking outside
  document.addEventListener('click', function(e) {
    const btn = document.getElementById('escalate-btn');
    const dropdown = document.getElementById('escalation-dropdown');
    if (dropdown && !dropdown.classList.contains('hidden') && btn && !btn.contains(e.target)) {
      dropdown.classList.add('hidden');
    }
  });
