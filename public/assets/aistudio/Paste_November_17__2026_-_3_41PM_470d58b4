      showToast('Log lapangan berhasil tersimpan & terkirim ke NOC');
      input.value = '';
    } else {
      showToast('Status WO telah diperbarui');
    }
    if (modal) modal.classList.add('hidden');
  }

  function triggerPhotoUpload() {
    const fileInput = document.getElementById('camera-file-input');
    if (fileInput) fileInput.click();
  }

  function handlePhotoCaptured(input) {
    if (input.files && input.files[0]) {
      showToast('Foto bukti (' + input.files[0].name.substring(0, 15) + '...) berhasil diunggah');
    }
  }

  function handleHoldWorkOrder() {
    toggleEscalationMenu();
