<script>
  function filterUsers() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    const role = document.getElementById('roleFilter').value;
    const area = document.getElementById('areaFilter').value;
    const status = document.getElementById('statusFilter').value;

    const rows = document.querySelectorAll('.user-row');
    let visibleCount = 0;

    rows.forEach((row) => {
      const name = row.getAttribute('data-name');
      const id = row.getAttribute('data-id');
      const email = row.getAttribute('data-email');
      const rowRole = row.getAttribute('data-role');
      const rowArea = row.getAttribute('data-area');
      const rowStatus = row.getAttribute('data-status');

      const matchesQuery = name.includes(query) || id.includes(query) || email.includes(query);
      const matchesRole = role === 'ALL' || rowRole === role;
      const matchesArea = area === 'ALL' || rowArea === area;
      const matchesStatus = status === 'ALL' || rowStatus === status;

      if (matchesQuery && matchesRole && matchesArea && matchesStatus) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    document.getElementById('tableCountBadge').textContent = `Menampilkan ${visibleCount} dari 142 User`;
  }

  function focusFilterBar() {
    const input = document.getElementById('searchInput');
    input.scrollIntoView({ behavior: 'smooth', block: 'center' });
    input.focus();
  }

  function openUserModal() {
    showToast('Membuka form Tambah User Baru...');
  }

  let toastTimer;
  function showToast(msg) {
    const banner = document.getElementById('toastBanner');
    const text = document.getElementById('toastMessage');
    text.textContent = msg;
    banner.classList.remove('hidden');
    banner.classList.add('flex');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      banner.classList.add('hidden');
      banner.classList.remove('flex');
    }, 3000);
  }
</script></main></div></body></html>