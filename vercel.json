{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "api/_server.mjs"
    }
  },
  "headers": [
    {
      "source": "/((?!api(?:/|$)|assets/|.*\\.(?:js|mjs|css|map|json|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__vercel_path="
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vercel_path=$1"
    },
    {
      "source": "/((?!api(?:/|$)|assets/|.*\\.(?:js|mjs|css|map|json|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-maintenance",
      "schedule": "5 17 * * *"
    }
  ]
}
