# ==============================================================================
# MoraJaws Environment Variables Template
# ==============================================================================
# NEVER commit real secrets or service-role keys. Set secrets in Vercel Project
# Environment Variables (separated across Development / Preview / Production).

# --- Runtime & Hosting ---
APP_ENV=
APP_BASE_URL=
API_ONLY_MODE=
ALLOW_LOCAL_JSON_MODE=
CORS_ALLOWED_ORIGINS=
AUTH_ALLOWED_REDIRECT_ORIGINS=
AUTH_RECOVERY_CALLBACK_URL=
AUTH_COOKIE_ONLY_MODE=
CRON_SECRET=
ENABLE_SSE_SANDBOX=
SANDBOX_SUPER_ADMIN_EMAILS=
DISABLE_HMR=

# --- Primary Active Environment Supabase Credentials (Server-Side Only) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_ENABLED=
SUPABASE_STORAGE_BUCKET=
DATABASE_URL=

# --- Environment-Scoped Overrides (Development / Staging / Production) ---
DEV_APP_BASE_URL=
DEV_AUTH_RECOVERY_CALLBACK_URL=
DEV_SUPABASE_URL=
DEV_SUPABASE_ANON_KEY=
DEV_SUPABASE_SERVICE_ROLE_KEY=

STAGING_APP_BASE_URL=
STAGING_AUTH_RECOVERY_CALLBACK_URL=
STAGING_ALLOWED_REDIRECT_ORIGINS=
STAGING_SUPABASE_PROJECT_ID=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_SECRET_KEY=

PRODUCTION_APP_BASE_URL=
PRODUCTION_AUTH_RECOVERY_CALLBACK_URL=
PRODUCTION_ALLOWED_REDIRECT_ORIGINS=
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_ANON_KEY=
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
PRODUCTION_SUPABASE_SECRET_KEY=

# --- Email / SMTP / Webhook Notifications (Server-Side Only) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Optional Integrations ---
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_ACCESS_TOKEN=

# --- Frontend Build Variables (Non-Sensitive Public Only) ---
VITE_GOOGLE_OAUTH_CLIENT_ID=